# Node / build artifacts
node_modules/

# WSS 稳定性探针会持续写本地 JSONL；其中虽已主动脱敏，但仍属于一次性诊断产物。
data/wss-probe-*.jsonl
data/wss-probe-*.jsonl.summary.json
.output/
.wxt/
dist/

# Local archive database/runtime state
# data/ 全部属于本机运行态/取证产物（主 SQLite、WAL、trace、assets、protocol probes 等），
# 仓库没有任何需要版本控制的 data/ 文件。整目录忽略，避免误用 `git add .` 把聊天库提交进去。
data/
data/*.sqlite
data/*.sqlite-*
data/raw/
data/recovery-ledger.json
data/archive-daemon*.json
data/archive-notification.local.json
data/active-turn-trace*.jsonl
data/archive-actor-state.json

# Temporary research clones, test downloads and local HTTP server state
.tmp/

# Generated upstream status report (CI also writes it to the job summary)
upstream/REPORT.md

# Local OS/editor noise
.DS_Store
Thumbs.db
*.log
